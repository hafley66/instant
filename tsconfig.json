{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@hafley66/boop-adapters": ["../hafley-rxjs/packages/boop-adapters/dist/index.d.ts"],
      "@hafley66/marbler-runtime": ["../hafley-rxjs/packages/marbler/src/2_Marbler.tsx"],
      "@hafley66/marbler-model": ["../hafley-rxjs/packages/marbler/src/1_model.ts"]
    },
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "packages/md/src"]
}
