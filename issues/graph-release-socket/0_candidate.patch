+    // effective_tmux_socket is what the session-graph liveness probe receives.
+    // A configured socket always wins; with none, a debug build must stay on the
+    // default server (matching boop-mux) and a release build must resolve to the
+    // same `instant-prod` server its pty writes to.
+    #[test]
+    fn effective_tmux_socket_prefers_config_and_falls_back_for_release() {
+        let saved = std::env::var("INSTANT_TMUX_SOCKET").ok();
+
+        std::env::set_var("INSTANT_TMUX_SOCKET", "instant-dev-test");
+        assert_eq!(effective_tmux_socket().as_deref(), Some("instant-dev-test"));
+
+        std::env::remove_var("INSTANT_TMUX_SOCKET");
+        assert_eq!(configured_tmux_socket(), None);
+        if cfg!(debug_assertions) {
+            assert_eq!(effective_tmux_socket(), None, "debug keeps the default server");
+        } else {
+            assert_eq!(
+                effective_tmux_socket().as_deref(),
+                Some(DEFAULT_PROD_TMUX_SOCKET),
+                "release probes the same private server its pty writes to"
+            );
+        }
+
+        match saved {
+            Some(value) => std::env::set_var("INSTANT_TMUX_SOCKET", value),
+            None => std::env::remove_var("INSTANT_TMUX_SOCKET"),
+        }
+    }
