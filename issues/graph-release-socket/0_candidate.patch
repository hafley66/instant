+/// The release-only tmux server. A prod build is launched by macOS without a
+/// login shell and keeps its panes off the default socket so a `tauri dev`
+/// instance (or the user's own terminal) is untouched. Defined once so readers
+/// of liveness and writers of panes can never name different servers.
+pub(crate) const DEFAULT_PROD_TMUX_SOCKET: &str = "instant-prod";
+
+/// The server this process's tmux panes actually live on: the configured
+/// `INSTANT_TMUX_SOCKET`, else the release default. A reader that probes
+/// liveness (the offline session graph) must pass this to boop-mux's
+/// `Multiplexer`, not the raw env value: in a release build with no env the raw
+/// value is `None` and boop-mux then probes the *default* server, so every one
+/// of the app's own `instant-prod` panes reads as dead.
+pub(crate) fn effective_tmux_socket() -> Option<String> {
+    configured_tmux_socket()
+        .or_else(|| (!cfg!(debug_assertions)).then(|| DEFAULT_PROD_TMUX_SOCKET.to_string()))
+}
