FROM node:22-bookworm AS verify

ENV CI=1
WORKDIR /instant

RUN corepack enable && corepack prepare pnpm@10.12.4 --activate

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
RUN pnpm exec playwright install --with-deps chromium

COPY . .

RUN pnpm run build
RUN pnpm exec vitest run --config labs/json-rx-mvp/5_vitest.config.ts
RUN pnpm exec tsc --project labs/json-rx-mvp/6_tsconfig.json
RUN pnpm exec playwright test --config labs/json-rx-mvp/14_playwright.config.ts
