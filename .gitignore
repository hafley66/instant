# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Vendored third-party apps (rebuilt by scripts/vendor-*.sh)
/public/vendor/
!/public/vendor/
!/public/vendor/miniPaint/
!/public/vendor/miniPaint/**

# vscode-ext build output + packaged extension
vscode-ext/out
*.vsix

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Playwright run artifacts (traces, actual/diff images). Snapshot baselines
# live next to their spec in e2e/*-snapshots/ and stay tracked.
/test-results/

# Live-spawn gate scratch (`just livespawn`): a scratch cwd, a mailbox, one
# JSON + PNG per poll sample. Regenerated by every run, never a baseline.
/.livespawn/

# concatMap lane runtime: cursor/queue state and rendered turn output.
/state/
/out/

