{
  "name": "instant",
  "private": true,
  "version": "0.1.19",
  "packageManager": "pnpm@10.12.4",
  "type": "module",
  "scripts": {
    "api:generate": "node scripts/generate-api.mjs && node scripts/generate-native.mjs",
    "api:check": "node scripts/generate-api.mjs --check && node scripts/generate-native.mjs --check",
    "dev": "vite",
    "build": "node scripts/generate-api.mjs --check && node scripts/generate-native.mjs --check && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "ext:build": "node extension/build.mjs",
    "ext:watch": "node extension/build.mjs --watch",
    "ext:check": "tsc -p extension/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:web": "playwright test",
    "native:e2e:build": "tauri build --debug --no-bundle --features native-e2e --config src-tauri/tauri.native-e2e.conf.json",
    "test:e2e:native": "pnpm native:e2e:build && wdio run wdio.native.conf.ts",
    "test:live": "playwright test -c playwright.live.config.ts",
    "test:replay:corpus": "node scripts/1_transcriptCorpus.mjs",
    "test:replay:terminal": "playwright test -c playwright.live.config.ts e2e-live/1_terminal-cast.live.ts",
    "test:replay:conversation": "playwright test e2e/term-turn-attribution-real.spec.ts",
    "test:replay:agents": "playwright test -c playwright.live.config.ts e2e-live/2_agent-tui.live.ts",
    "replay:setup": "cargo install --root .replay-tools/llmock --git https://github.com/larsakerlund/llmock.git --tag v0.1.2 --locked llmock",
    "test:replay": "pnpm test:replay:corpus && pnpm test:replay:terminal && pnpm test:replay:conversation && pnpm test:replay:agents"
  },
  "dependencies": {
    "@hafley66/grid": "0.1.7",
    "@hafley66/json-rx": "0.1.2",
    "@hafley66/md": "0.1.1-dev.1788134367104",
    "@hafley66/signals": "0.1.1",
    "@oddbird/css-anchor-positioning": "^0.9.0",
    "@react95/icons": "^2.5.0",
    "@streamdown/code": "^1.1.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.3",
    "@tanstack/virtual-core": "^3.17.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@terrastruct/d2": "^0.1.33",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "d3-brush": "^3.0.0",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "dockview": "^6.6.1",
    "dockview-core": "^6.6.1",
    "dompurify": "^3.4.11",
    "json-logic-js": "^2.0.5",
    "jsonata": "^2.2.2",
    "lodash": "^4.17.21",
    "marked": "^18.0.5",
    "mermaid": "^11.16.0",
    "monaco-editor": "^0.56.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-resizable-panels": "^3.0.6",
    "remark-parse": "^11.0.0",
    "rxjs": "^7.8.2",
    "shiki": "^4.2.0",
    "streamdown": "^2.5.0",
    "tinykeys": "^4.0.0",
    "unified": "^11.0.5",
    "vega": "^6.3.1",
    "vega-embed": "^7.1.0",
    "vega-lite": "^6.4.3",
    "xp.css": "^0.2.6"
  },
  "devDependencies": {
    "@microsoft/tui-test": "0.1.0-beta.2",
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "^2",
    "@types/chrome": "^0.2.2",
    "@types/d3": "^7.4.3",
    "@types/d3-brush": "^3.0.6",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/json-logic-js": "^2.0.8",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "@wdio/cli": "9.31.5",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.31.5",
    "@wdio/mocha-framework": "9.31.5",
    "@wdio/spec-reporter": "9.31.2",
    "@wdio/tauri-service": "1.3.0",
    "jsdom": "^30.0.1",
    "typescript": "~5.6.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.9",
    "webdriverio": "9.31.5",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "overrides": {
      "@streamdown/code>shiki": "$shiki",
      "streamdown>marked": "$marked",
      "streamdown>mermaid": "$mermaid"
    }
  }
}
