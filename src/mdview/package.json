{
  "name": "@instant/mdview",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Sectioned markdown viewer: heading tree, list/section folding, in-doc navigation, and a mermaid-aware renderer. Talks to its host app only through ports.ts (MdviewHost).",
  "main": "index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.css",
    "!**/*.test.ts"
  ],
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "dockview": "^6.6.1",
    "streamdown": "^2.5.0",
    "@streamdown/code": "^1.1.1",
    "mermaid": "^11.16.0",
    "unified": "^11.0.5",
    "remark-parse": "^11.0.0",
    "react-resizable-panels": "^3.0.6",
    "@hafley66/signals": "0.0.2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "vitest": "^4.1.9"
  }
}
